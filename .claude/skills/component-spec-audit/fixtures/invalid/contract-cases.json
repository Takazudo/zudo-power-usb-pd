{
  "schema_version": 1,
  "contract": "Each case mutates one base fixture and must fail for the stated reason. Bases: inventory and candidates use fixtures/synthetic/, golden uses fixtures/golden/critical-facts.json, template uses assets/component-skill-template/.",
  "cases": [
    {
      "name": "wrong-mpn",
      "base": "inventory",
      "target": "lines.line-c23186.mpn",
      "value": "WRONG-MPN",
      "expected_error": "MPN"
    },
    {
      "name": "wrong-lcsc",
      "base": "inventory",
      "target": "lines.line-c23186.lcsc",
      "value": "C999999",
      "expected_error": "LCSC"
    },
    {
      "name": "wrong-package",
      "base": "inventory",
      "target": "lines.line-c23186.package",
      "value": "WRONG-PACKAGE",
      "expected_error": "package"
    },
    {
      "name": "duplicate-ownership",
      "base": "inventory",
      "target": "lines.line-c144397.line_id",
      "value": "line-c23186",
      "expected_error": "duplicate line_id"
    },
    {
      "name": "wrong-refdes",
      "base": "inventory",
      "target": "lines.line-c23186.placements.0.refdes",
      "value": "R99",
      "expected_error": "board/refdes or DNP mismatch"
    },
    {
      "name": "unknown-board",
      "base": "inventory",
      "target": "lines.line-c23186.placements.0.board",
      "value": "board-c",
      "expected_error": "unknown board"
    },
    {
      "name": "audit-skill-as-owner",
      "base": "inventory",
      "target": "lines.line-c23186.owner_skill",
      "value": "component-spec-audit",
      "expected_error": "owner skill"
    },
    {
      "name": "candidate-owner-not-a-component-skill",
      "base": "candidates",
      "target": "candidates.cand-fixture-tvs-replacement.owner_skill",
      "value": "circuit-spec-integration",
      "expected_error": "owner skill"
    },
    {
      "name": "candidate-invalid-lcsc",
      "base": "candidates",
      "target": "candidates.cand-fixture-tvs-replacement.lcsc",
      "value": "900003",
      "expected_error": "invalid LCSC identifier"
    },
    {
      "name": "missing-locator",
      "base": "golden",
      "target": "facts.fact-golden-limit.locator",
      "value": "",
      "expected_error": "locator"
    },
    {
      "name": "unsourced-manufacturer",
      "base": "template",
      "target": "facts.fact-example-manufacturer.provenance",
      "value": "PROJECT-CHOICE",
      "expected_error": "manufacturer"
    },
    {
      "name": "unavailable-without-state",
      "base": "template",
      "target": "sources.src-example.availability",
      "value": "",
      "expected_error": "availability"
    },
    {
      "name": "stale-online-hash",
      "base": "template",
      "target": "sources.src-example.sha256",
      "value": "xyz",
      "expected_error": "SHA-256"
    },
    {
      "name": "raw-fact-dependency",
      "base": "golden",
      "target": "facts.fact-golden-limit.depends_on",
      "value": ["fact-golden-margin"],
      "expected_error": "raw fact"
    },
    {
      "name": "unacknowledged-gap",
      "base": "template",
      "target": "coverage.cov-example-pinout.status",
      "value": "UNKNOWN",
      "expected_error": "coverage"
    },
    {
      "name": "record-claims-line-and-candidate",
      "base": "template",
      "target": "records.rec-example.candidate_id",
      "value": "cand-example",
      "expected_error": "exactly one of line_id and candidate_id"
    },
    {
      "name": "record-claims-neither-line-nor-candidate",
      "base": "template",
      "target": "records.rec-example.line_id",
      "value": null,
      "expected_error": "exactly one of line_id and candidate_id"
    }
  ]
}
